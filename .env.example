# 默认无 AWS、无 Docker、无密钥即可启动。收藏会持久化在 .data/users.json。
# API 监听端口；网页在 dev:web 命令中显式使用 3000，避免继承 PORT 后冲突。
PORT=3001
HOST=127.0.0.1
STORE_DRIVER=file
DATA_FILE=.data/users.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# 可选 Go 网关模式：设置后业务由 Go 执行；留空保持原 Node.js 实现。
# 这是后端私有地址，禁止添加 NEXT_PUBLIC_ 前缀。Go 不可用时返回错误，不自动切换存储。
# GO_API_BASE_URL=http://127.0.0.1:8080

# 可选：提升 GitHub API 限流额度，仅后端读取，禁止 NEXT_PUBLIC_ 前缀。
# GITHUB_TOKEN=

# PostgreSQL 模式：docker compose up -d，然后 npm run db:migrate
# STORE_DRIVER=postgres
# DATABASE_URL=postgresql://github_app:local_dev_password@localhost:5432/github_search
# DATABASE_SSL=false

# Aurora Express IAM 模式：设置以下项，同时将 STORE_DRIVER 改为 postgres。
# DB_AUTH=iam
# DB_HOST=your-cluster.ap-southeast-2.rds.amazonaws.com
# DB_USER=postgres
# DB_NAME=github_search
# DB_PORT=5432
# DATABASE_SSL=true
# AWS_PROFILE=aws-course
# AWS_REGION=ap-southeast-2

# 可选：本地也启用访问令牌；网页右上角配置，禁止写入前端构建变量。
# API_ACCESS_TOKEN=replace-with-a-long-random-value
