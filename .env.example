# 默认无 AWS、无 Docker、无密钥即可启动。收藏会持久化在 .data/users.json。
PORT=3001
HOST=127.0.0.1
STORE_DRIVER=file
DATA_FILE=.data/users.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# 可选：提升 GitHub API 限流额度，仅后端读取，禁止 NEXT_PUBLIC_ 前缀。
# GITHUB_TOKEN=

# PostgreSQL 模式：docker compose up -d，然后 npm run db:migrate
# STORE_DRIVER=postgres
# DATABASE_URL=postgresql://github_app:local_dev_password@localhost:5432/github_search
# DATABASE_SSL=false

# 可选：本地也启用访问令牌；网页右上角配置，禁止写入前端构建变量。
# API_ACCESS_TOKEN=replace-with-a-long-random-value
